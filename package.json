{
  "name": "opencode-v2-security",
  "version": "1.5.0",
  "description": "Autonomous execution-boundary security for OpenCode V2: scoped assessments, one-call authorization, bypass leases, and session read/write permission ceilings.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDwsgood/opencode-v2-security.git"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./tui": {
      "import": "./src/tui.tsx",
      "types": "./src/tui.tsx"
    }
  },
  "files": [
    "RESEARCH-v1.5.0.md",
    "JEV-EXECUTION-SCOPE-PROMPT.md",
    "RESEARCH-JEV-PAYLOAD-20261003.md",
    "research/jev-payload-20261003",
    "RESEARCH-v1.4.0.md",
    "RESEARCH-v1.3.0.md",
    "index.ts",
    "tui.ts",
    "src",
    "!src/**/__pycache__",
    "!src/**/*.pyc",
    "bin",
    "native/linux-sandbox",
    "native/windows-bash-supervisor/README.md",
    "native/windows-bash-supervisor/Cargo.toml",
    "native/windows-bash-supervisor/Cargo.lock",
    "native/windows-bash-supervisor/src/main.rs",
    "native/windows-bash-supervisor/target/release/bash.exe",
    "native/windows-bash-supervisor/target/release/opencode-bash-supervisor.exe"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "opencode-v2-security",
    "security",
    "permissions",
    "sandbox",
    "landlock",
    "bash",
    "shell",
    "command-classifier",
    "llm-reviewer",
    "openai-compatible"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "next",
    "@opentui/solid": ">=0.5.8 <0.6.0",
    "solid-js": ">=1.9.12 <2.0.0",
    "effect": ">=4.0.0-beta.83 <4.0.0"
  }
}
